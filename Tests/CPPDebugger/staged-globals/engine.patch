+/// Variables defined at compilation-unit or namespace scope. Do not descend
+/// into functions or types: their variables are not global variables.
+pub fn get_globals(root: &Die<'_>) -> Vec<DieReference> {
+    let mut result = Vec::new();
+    root.traverse(|die| match die.tag() {
+        gimli::DW_TAG_compile_unit | gimli::DW_TAG_namespace => Visit::Continue,
+        gimli::DW_TAG_variable => {
+            if !die.has_flag(gimli::DW_AT_declaration)
+                && !die.has_flag(gimli::DW_AT_artificial)
+                && die.qualified_name().is_some_and(|name| !name.is_empty())
+                && (die.has_attr(gimli::DW_AT_location) || die.has_attr(gimli::DW_AT_const_value))
+            {
+                result.push(die.die_ref());
+            }
+            Visit::SkipChildren
+        }
+        _ => Visit::SkipChildren,
+    });
+    result
+}
